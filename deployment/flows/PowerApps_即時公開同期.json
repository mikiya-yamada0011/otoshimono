{
  "properties": {
    "displayName": "LFSyncPublicItem",
    "connectionReferences": {},
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "PowerAppV2",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "number": {
                  "description": "同期するFoundItemsのID",
                  "title": "ItemId",
                  "type": "number",
                  "x-ms-content-hint": "NUMBER",
                  "x-ms-dynamically-added": true
                },
                "number_1": {
                  "description": "旧版との互換入力（使用しません）",
                  "title": "RequestId",
                  "type": "number",
                  "x-ms-content-hint": "NUMBER",
                  "x-ms-dynamically-added": true
                }
              },
              "required": [
                "number"
              ]
            }
          }
        }
      },
      "actions": {
        "Item": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "HttpRequest"
            },
            "parameters": {
              "dataset": "https://cloudkobeu.sharepoint.com/teams/t-dxsuisin-tesvd2",
              "parameters/method": "GET",
              "parameters/uri": "_api/web/lists/getbytitle('FoundItems')/items(@{triggerBody()?['number']})",
              "parameters/headers": {
                "Accept": "application/json;odata=minimalmetadata",
                "Content-Type": "application/json;odata=nometadata"
              }
            },
            "authentication": {
              "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']",
              "type": "Raw"
            }
          },
          "runAfter": {}
        },
        "Projection": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "HttpRequest"
            },
            "parameters": {
              "dataset": "https://cloudkobeu.sharepoint.com/teams/t-dxsuisin-tesvd2",
              "parameters/method": "GET",
              "parameters/uri": "_api/web/lists/getbytitle('LFPublicItems')/items?$filter=Title eq 'public:@{body('Item')?['Id']}'&$top=1",
              "parameters/headers": {
                "Accept": "application/json;odata=minimalmetadata",
                "Content-Type": "application/json;odata=nometadata"
              }
            },
            "authentication": {
              "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']",
              "type": "Raw"
            }
          },
          "runAfter": {
            "Item": [
              "Succeeded"
            ]
          }
        },
        "Public": {
          "type": "If",
          "expression": "@and(or(equals(body('Item')?['Status'],'保管中'),equals(body('Item')?['Status'],'移管済み')),equals(body('Item')?['IsPublic'],true),not(empty(body('Item')?['ParentCategoryCode'])))",
          "actions": {
            "Exists": {
              "type": "If",
              "expression": "@greater(length(body('Projection')?['value']),0)",
              "actions": {
                "UpdatePublic_Body": {
                  "type": "Compose",
                  "inputs": {
                    "Title": "public:@{body('Item')?['Id']}",
                    "SourceItemId": "@string(body('Item')?['Id'])",
                    "ItemTitle": "@body('Item')?['Title']",
                    "ParentCategoryCode": "@body('Item')?['ParentCategoryCode']",
                    "CategoryCode": "@coalesce(body('Item')?['CategoryCode'],'')",
                    "Colors": "@coalesce(body('Item')?['Color'],'')",
                    "CampusCode": "@coalesce(body('Item')?['CampusCode'],'')",
                    "BuildingCode": "@coalesce(body('Item')?['BuildingCode'],'')",
                    "Place": "@coalesce(body('Item')?['Place'],'')",
                    "FoundOn": "@body('Item')?['FoundOn']",
                    "StorageWindow": "@coalesce(body('Item')?['StorageWindow'],'')",
                    "Feature": "@coalesce(body('Item')?['Feature'],'')",
                    "ItemStatus": "@body('Item')?['Status']",
                    "TransferredAt": "@if(and(equals(body('Item')?['Status'],'移管済み'),contains(coalesce(body('Item')?['InternalNote'],''),'[移管 '),contains(last(split(coalesce(body('Item')?['InternalNote'],''),'[移管 ')),'] 移管先：'),contains(last(split(coalesce(body('Item')?['InternalNote'],''),'[移管 ')),'／担当：')),first(skip(split(first(split(last(split(coalesce(body('Item')?['InternalNote'],''),'[移管 ')),']')),' '),1)),'')",
                    "TransferDestination": "@if(and(equals(body('Item')?['Status'],'移管済み'),contains(coalesce(body('Item')?['InternalNote'],''),'[移管 '),contains(last(split(coalesce(body('Item')?['InternalNote'],''),'[移管 ')),'] 移管先：'),contains(last(split(coalesce(body('Item')?['InternalNote'],''),'[移管 ')),'／担当：')),trim(first(split(last(split(last(split(coalesce(body('Item')?['InternalNote'],''),'[移管 ')),'] 移管先：')),'／担当：'))),'')",
                    "SourceCreatedAt": "@body('Item')?['Created']"
                  },
                  "runAfter": {}
                },
                "UpdatePublic": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "connectionName": "shared_sharepointonline",
                      "operationId": "HttpRequest"
                    },
                    "parameters": {
                      "dataset": "https://cloudkobeu.sharepoint.com/teams/t-dxsuisin-tesvd2",
                      "parameters/method": "POST",
                      "parameters/uri": "_api/web/lists/getbytitle('LFPublicItems')/items(@{first(body('Projection')?['value'])?['Id']})",
                      "parameters/headers": {
                        "Accept": "application/json;odata=minimalmetadata",
                        "Content-Type": "application/json;odata=nometadata",
                        "X-HTTP-Method": "MERGE",
                        "IF-MATCH": "@first(body('Projection')?['value'])?['odata.etag']"
                      },
                      "parameters/body": "@string(outputs('UpdatePublic_Body'))"
                    },
                    "authentication": {
                      "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']",
                      "type": "Raw"
                    }
                  },
                  "runAfter": {
                    "UpdatePublic_Body": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "else": {
                "actions": {
                  "CreatePublic_Body": {
                    "type": "Compose",
                    "inputs": {
                      "Title": "public:@{body('Item')?['Id']}",
                      "SourceItemId": "@string(body('Item')?['Id'])",
                      "ItemTitle": "@body('Item')?['Title']",
                      "ParentCategoryCode": "@body('Item')?['ParentCategoryCode']",
                      "CategoryCode": "@coalesce(body('Item')?['CategoryCode'],'')",
                      "Colors": "@coalesce(body('Item')?['Color'],'')",
                      "CampusCode": "@coalesce(body('Item')?['CampusCode'],'')",
                      "BuildingCode": "@coalesce(body('Item')?['BuildingCode'],'')",
                      "Place": "@coalesce(body('Item')?['Place'],'')",
                      "FoundOn": "@body('Item')?['FoundOn']",
                      "StorageWindow": "@coalesce(body('Item')?['StorageWindow'],'')",
                      "Feature": "@coalesce(body('Item')?['Feature'],'')",
                      "ItemStatus": "@body('Item')?['Status']",
                      "TransferredAt": "@if(and(equals(body('Item')?['Status'],'移管済み'),contains(coalesce(body('Item')?['InternalNote'],''),'[移管 '),contains(last(split(coalesce(body('Item')?['InternalNote'],''),'[移管 ')),'] 移管先：'),contains(last(split(coalesce(body('Item')?['InternalNote'],''),'[移管 ')),'／担当：')),first(skip(split(first(split(last(split(coalesce(body('Item')?['InternalNote'],''),'[移管 ')),']')),' '),1)),'')",
                      "TransferDestination": "@if(and(equals(body('Item')?['Status'],'移管済み'),contains(coalesce(body('Item')?['InternalNote'],''),'[移管 '),contains(last(split(coalesce(body('Item')?['InternalNote'],''),'[移管 ')),'] 移管先：'),contains(last(split(coalesce(body('Item')?['InternalNote'],''),'[移管 ')),'／担当：')),trim(first(split(last(split(last(split(coalesce(body('Item')?['InternalNote'],''),'[移管 ')),'] 移管先：')),'／担当：'))),'')",
                      "SourceCreatedAt": "@body('Item')?['Created']"
                    },
                    "runAfter": {}
                  },
                  "CreatePublic": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                        "connectionName": "shared_sharepointonline",
                        "operationId": "HttpRequest"
                      },
                      "parameters": {
                        "dataset": "https://cloudkobeu.sharepoint.com/teams/t-dxsuisin-tesvd2",
                        "parameters/method": "POST",
                        "parameters/uri": "_api/web/lists/getbytitle('LFPublicItems')/items",
                        "parameters/headers": {
                          "Accept": "application/json;odata=minimalmetadata",
                          "Content-Type": "application/json;odata=nometadata"
                        },
                        "parameters/body": "@string(outputs('CreatePublic_Body'))"
                      },
                      "authentication": {
                        "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']",
                        "type": "Raw"
                      }
                    },
                    "runAfter": {
                      "CreatePublic_Body": [
                        "Succeeded"
                      ]
                    }
                  }
                }
              },
              "runAfter": {}
            }
          },
          "else": {
            "actions": {
              "RemoveProjection": {
                "type": "Foreach",
                "foreach": "@body('Projection')?['value']",
                "actions": {
                  "DeletePublic_Body": {
                    "type": "Compose",
                    "inputs": {},
                    "runAfter": {}
                  },
                  "DeletePublic": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                        "connectionName": "shared_sharepointonline",
                        "operationId": "HttpRequest"
                      },
                      "parameters": {
                        "dataset": "https://cloudkobeu.sharepoint.com/teams/t-dxsuisin-tesvd2",
                        "parameters/method": "POST",
                        "parameters/uri": "_api/web/lists/getbytitle('LFPublicItems')/items(@{items('RemoveProjection')?['Id']})",
                        "parameters/headers": {
                          "Accept": "application/json;odata=minimalmetadata",
                          "Content-Type": "application/json;odata=nometadata",
                          "X-HTTP-Method": "DELETE",
                          "IF-MATCH": "@items('RemoveProjection')?['odata.etag']"
                        },
                        "parameters/body": "@string(outputs('DeletePublic_Body'))"
                      },
                      "authentication": {
                        "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']",
                        "type": "Raw"
                      }
                    },
                    "runAfter": {
                      "DeletePublic_Body": [
                        "Succeeded"
                      ]
                    }
                  }
                },
                "runtimeConfiguration": {
                  "concurrency": {
                    "repetitions": 1
                  }
                },
                "runAfter": {}
              }
            }
          },
          "runAfter": {
            "Projection": [
              "Succeeded"
            ]
          }
        }
      },
      "outputs": {}
    }
  }
}
