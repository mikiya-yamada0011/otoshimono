{
  "properties": {
    "displayName": "落とし物 QRなし PowerApps_返却記録の反映",
    "connectionReferences": {},
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "changed": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetOnUpdatedItems"
            },
            "parameters": {
              "dataset": "https://cloudkobeu.sharepoint.com/teams/t-dxsuisin-tesvd2",
              "table": "617870b8-de06-454f-8267-993453389662"
            },
            "authentication": "@parameters('$authentication')"
          },
          "recurrence": {
            "frequency": "Minute",
            "interval": 1
          },
          "splitOn": "@triggerOutputs()?['body/value']",
          "runtimeConfiguration": {
            "concurrency": {
              "runs": 1
            }
          }
        }
      },
      "actions": {
        "Item": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "HttpRequest"
            },
            "parameters": {
              "dataset": "https://cloudkobeu.sharepoint.com/teams/t-dxsuisin-tesvd2",
              "parameters/method": "GET",
              "parameters/uri": "_api/web/lists/getbytitle('FoundItems')/items(@{triggerBody()?['ID']})",
              "parameters/headers": {
                "Accept": "application/json;odata=minimalmetadata",
                "Content-Type": "application/json;odata=nometadata"
              }
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {}
        },
        "CandidateItemEnded": {
          "type": "If",
          "expression": "@or(equals(body('Item')?['Status'],'返却済み'),equals(body('Item')?['Status'],'移管済み'))",
          "actions": {
            "CandidateNotices": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItems"
                },
                "parameters": {
                  "dataset": "https://cloudkobeu.sharepoint.com/teams/t-dxsuisin-tesvd2",
                  "table": "9c910cf5-0120-4d66-9c0a-ba5b54d1b131",
                  "$filter": "ItemId eq '@{body('Item')?['Id']}' and NoticeKind eq 'VALUABLE'"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runtimeConfiguration": {
                "paginationPolicy": {
                  "minimumItemCount": 5000
                }
              },
              "runAfter": {}
            },
            "EachCandidateNotice": {
              "type": "Foreach",
              "foreach": "@body('CandidateNotices')?['value']",
              "actions": {
                "CandidateCurrentItem": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "connectionName": "shared_sharepointonline",
                      "operationId": "HttpRequest"
                    },
                    "parameters": {
                      "dataset": "https://cloudkobeu.sharepoint.com/teams/t-dxsuisin-tesvd2",
                      "parameters/method": "GET",
                      "parameters/uri": "_api/web/lists/getbytitle('FoundItems')/items(@{body('Item')?['Id']})",
                      "parameters/headers": {
                        "Accept": "application/json;odata=minimalmetadata",
                        "Content-Type": "application/json;odata=nometadata"
                      }
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {}
                },
                "CandidateCurrentNotice": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "connectionName": "shared_sharepointonline",
                      "operationId": "HttpRequest"
                    },
                    "parameters": {
                      "dataset": "https://cloudkobeu.sharepoint.com/teams/t-dxsuisin-tesvd2",
                      "parameters/method": "GET",
                      "parameters/uri": "_api/web/lists/getbytitle('LFNotices')/items(@{items('EachCandidateNotice')?['ID']})",
                      "parameters/headers": {
                        "Accept": "application/json;odata=minimalmetadata",
                        "Content-Type": "application/json;odata=nometadata"
                      }
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {
                    "CandidateCurrentItem": [
                      "Succeeded"
                    ]
                  }
                },
                "CandidateStillEnded": {
                  "type": "If",
                  "expression": "@and(or(equals(body('CandidateCurrentItem')?['Status'],'返却済み'),equals(body('CandidateCurrentItem')?['Status'],'移管済み')),equals(body('CandidateCurrentNotice')?['ItemId'],string(body('CandidateCurrentItem')?['Id'])),not(equals(body('CandidateCurrentNotice')?['CandidateUnavailable'],true)))",
                  "actions": {
                    "RetireCandidate_Body": {
                      "type": "Compose",
                      "inputs": {
                        "CandidateUnavailable": true
                      },
                      "runAfter": {}
                    },
                    "RetireCandidate": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                          "connectionName": "shared_sharepointonline",
                          "operationId": "HttpRequest"
                        },
                        "parameters": {
                          "dataset": "https://cloudkobeu.sharepoint.com/teams/t-dxsuisin-tesvd2",
                          "parameters/method": "POST",
                          "parameters/uri": "_api/web/lists/getbytitle('LFNotices')/items(@{body('CandidateCurrentNotice')?['Id']})",
                          "parameters/headers": {
                            "Accept": "application/json;odata=minimalmetadata",
                            "Content-Type": "application/json;odata=nometadata",
                            "X-HTTP-Method": "MERGE",
                            "IF-MATCH": "@body('CandidateCurrentNotice')?['odata.etag']"
                          },
                          "parameters/body": "@string(outputs('RetireCandidate_Body'))"
                        },
                        "authentication": "@parameters('$authentication')"
                      },
                      "runAfter": {
                        "RetireCandidate_Body": [
                          "Succeeded"
                        ]
                      }
                    }
                  },
                  "else": {
                    "actions": {}
                  },
                  "runAfter": {
                    "CandidateCurrentNotice": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 1
                }
              },
              "runAfter": {
                "CandidateNotices": [
                  "Succeeded"
                ]
              }
            }
          },
          "else": {
            "actions": {}
          },
          "runAfter": {
            "Item": [
              "Succeeded"
            ]
          }
        },
        "Returned": {
          "type": "If",
          "expression": "@equals(body('Item')?['Status'],'返却済み')",
          "actions": {
            "HasClaim": {
              "type": "If",
              "expression": "@not(empty(body('Item')?['ClaimId']))",
              "actions": {
                "Claim": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "connectionName": "shared_sharepointonline",
                      "operationId": "HttpRequest"
                    },
                    "parameters": {
                      "dataset": "https://cloudkobeu.sharepoint.com/teams/t-dxsuisin-tesvd2",
                      "parameters/method": "GET",
                      "parameters/uri": "_api/web/lists/getbytitle('LFClaims')/items(@{int(body('Item')?['ClaimId'])})?$select=*,Author/EMail&$expand=Author",
                      "parameters/headers": {
                        "Accept": "application/json;odata=minimalmetadata",
                        "Content-Type": "application/json;odata=nometadata"
                      }
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {}
                },
                "ValidClaim": {
                  "type": "If",
                  "expression": "@and(equals(body('Claim')?['ItemId'],string(body('Item')?['Id'])),equals(body('Claim')?['ClaimStatus'],'PENDING'),equals(toLower(body('Claim')?['Author']?['EMail']),toLower(body('Item')?['ReturnRecipientEmail'])))",
                  "actions": {
                    "CompleteClaim_Body": {
                      "type": "Compose",
                      "inputs": {
                        "ClaimStatus": "RETURNED",
                        "ReturnedAt": "@body('Item')?['ReturnedAt']"
                      },
                      "runAfter": {}
                    },
                    "CompleteClaim": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                          "connectionName": "shared_sharepointonline",
                          "operationId": "HttpRequest"
                        },
                        "parameters": {
                          "dataset": "https://cloudkobeu.sharepoint.com/teams/t-dxsuisin-tesvd2",
                          "parameters/method": "POST",
                          "parameters/uri": "_api/web/lists/getbytitle('LFClaims')/items(@{body('Claim')?['Id']})",
                          "parameters/headers": {
                            "Accept": "application/json;odata=minimalmetadata",
                            "Content-Type": "application/json;odata=nometadata",
                            "X-HTTP-Method": "MERGE",
                            "IF-MATCH": "@body('Claim')?['odata.etag']"
                          },
                          "parameters/body": "@string(outputs('CompleteClaim_Body'))"
                        },
                        "authentication": "@parameters('$authentication')"
                      },
                      "runAfter": {
                        "CompleteClaim_Body": [
                          "Succeeded"
                        ]
                      }
                    }
                  },
                  "else": {
                    "actions": {}
                  },
                  "runAfter": {
                    "Claim": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {}
            },
            "HasRequest": {
              "type": "If",
              "expression": "@not(empty(body('Item')?['RequestId']))",
              "actions": {
                "LostRequest": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "connectionName": "shared_sharepointonline",
                      "operationId": "HttpRequest"
                    },
                    "parameters": {
                      "dataset": "https://cloudkobeu.sharepoint.com/teams/t-dxsuisin-tesvd2",
                      "parameters/method": "GET",
                      "parameters/uri": "_api/web/lists/getbytitle('LFRequests')/items(@{int(body('Item')?['RequestId'])})?$select=*,Author/EMail&$expand=Author",
                      "parameters/headers": {
                        "Accept": "application/json;odata=minimalmetadata",
                        "Content-Type": "application/json;odata=nometadata"
                      }
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {}
                },
                "Active": {
                  "type": "If",
                  "expression": "@and(equals(body('LostRequest')?['RequestStatus'],'ACTIVE'),equals(toLower(body('LostRequest')?['Author']?['EMail']),toLower(body('Item')?['ReturnRecipientEmail'])))",
                  "actions": {
                    "ResolveRequest_Body": {
                      "type": "Compose",
                      "inputs": {
                        "RequestStatus": "RESOLVED"
                      },
                      "runAfter": {}
                    },
                    "ResolveRequest": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                          "connectionName": "shared_sharepointonline",
                          "operationId": "HttpRequest"
                        },
                        "parameters": {
                          "dataset": "https://cloudkobeu.sharepoint.com/teams/t-dxsuisin-tesvd2",
                          "parameters/method": "POST",
                          "parameters/uri": "_api/web/lists/getbytitle('LFRequests')/items(@{body('LostRequest')?['Id']})",
                          "parameters/headers": {
                            "Accept": "application/json;odata=minimalmetadata",
                            "Content-Type": "application/json;odata=nometadata",
                            "X-HTTP-Method": "MERGE",
                            "IF-MATCH": "@body('LostRequest')?['odata.etag']"
                          },
                          "parameters/body": "@string(outputs('ResolveRequest_Body'))"
                        },
                        "authentication": "@parameters('$authentication')"
                      },
                      "runAfter": {
                        "ResolveRequest_Body": [
                          "Succeeded"
                        ]
                      }
                    }
                  },
                  "else": {
                    "actions": {}
                  },
                  "runAfter": {
                    "LostRequest": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "HasClaim": [
                  "Succeeded"
                ]
              }
            },
            "OtherPendingClaims": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItems"
                },
                "parameters": {
                  "dataset": "https://cloudkobeu.sharepoint.com/teams/t-dxsuisin-tesvd2",
                  "table": "d08a0352-5ab6-4c4c-80c5-ce864cf2b598",
                  "$filter": "ItemId eq '@{body('Item')?['Id']}' and ClaimStatus eq 'PENDING'"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runtimeConfiguration": {
                "paginationPolicy": {
                  "minimumItemCount": 5000
                }
              },
              "runAfter": {
                "HasRequest": [
                  "Succeeded"
                ]
              }
            },
            "EachOtherClaim": {
              "type": "Foreach",
              "foreach": "@body('OtherPendingClaims')?['value']",
              "actions": {
                "CurrentReturnedItem": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "connectionName": "shared_sharepointonline",
                      "operationId": "HttpRequest"
                    },
                    "parameters": {
                      "dataset": "https://cloudkobeu.sharepoint.com/teams/t-dxsuisin-tesvd2",
                      "parameters/method": "GET",
                      "parameters/uri": "_api/web/lists/getbytitle('FoundItems')/items(@{body('Item')?['Id']})",
                      "parameters/headers": {
                        "Accept": "application/json;odata=minimalmetadata",
                        "Content-Type": "application/json;odata=nometadata"
                      }
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {}
                },
                "OtherClaim": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "connectionName": "shared_sharepointonline",
                      "operationId": "HttpRequest"
                    },
                    "parameters": {
                      "dataset": "https://cloudkobeu.sharepoint.com/teams/t-dxsuisin-tesvd2",
                      "parameters/method": "GET",
                      "parameters/uri": "_api/web/lists/getbytitle('LFClaims')/items(@{items('EachOtherClaim')?['ID']})",
                      "parameters/headers": {
                        "Accept": "application/json;odata=minimalmetadata",
                        "Content-Type": "application/json;odata=nometadata"
                      }
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {
                    "CurrentReturnedItem": [
                      "Succeeded"
                    ]
                  }
                },
                "StillUnavailable": {
                  "type": "If",
                  "expression": "@and(equals(body('CurrentReturnedItem')?['Status'],'返却済み'),equals(body('OtherClaim')?['ItemId'],string(body('CurrentReturnedItem')?['Id'])),equals(body('OtherClaim')?['ClaimStatus'],'PENDING'),not(equals(string(body('OtherClaim')?['Id']),coalesce(body('CurrentReturnedItem')?['ClaimId'],''))))",
                  "actions": {
                    "CloseOtherClaim_Body": {
                      "type": "Compose",
                      "inputs": {
                        "ClaimStatus": "UNAVAILABLE"
                      },
                      "runAfter": {}
                    },
                    "CloseOtherClaim": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                          "connectionName": "shared_sharepointonline",
                          "operationId": "HttpRequest"
                        },
                        "parameters": {
                          "dataset": "https://cloudkobeu.sharepoint.com/teams/t-dxsuisin-tesvd2",
                          "parameters/method": "POST",
                          "parameters/uri": "_api/web/lists/getbytitle('LFClaims')/items(@{body('OtherClaim')?['Id']})",
                          "parameters/headers": {
                            "Accept": "application/json;odata=minimalmetadata",
                            "Content-Type": "application/json;odata=nometadata",
                            "X-HTTP-Method": "MERGE",
                            "IF-MATCH": "@body('OtherClaim')?['odata.etag']"
                          },
                          "parameters/body": "@string(outputs('CloseOtherClaim_Body'))"
                        },
                        "authentication": "@parameters('$authentication')"
                      },
                      "runAfter": {
                        "CloseOtherClaim_Body": [
                          "Succeeded"
                        ]
                      }
                    }
                  },
                  "else": {
                    "actions": {}
                  },
                  "runAfter": {
                    "OtherClaim": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 1
                }
              },
              "runAfter": {
                "OtherPendingClaims": [
                  "Succeeded"
                ]
              }
            }
          },
          "else": {
            "actions": {
              "Corrected": {
                "type": "If",
                "expression": "@and(equals(body('Item')?['Status'],'保管中'),not(empty(body('Item')?['ReturnAudit'])))",
                "actions": {
                  "ReturnedClaims": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                        "connectionName": "shared_sharepointonline",
                        "operationId": "GetItems"
                      },
                      "parameters": {
                        "dataset": "https://cloudkobeu.sharepoint.com/teams/t-dxsuisin-tesvd2",
                        "table": "d08a0352-5ab6-4c4c-80c5-ce864cf2b598",
                        "$filter": "ClaimStatus eq 'RETURNED'"
                      },
                      "authentication": "@parameters('$authentication')"
                    },
                    "runtimeConfiguration": {
                      "paginationPolicy": {
                        "minimumItemCount": 5000
                      }
                    },
                    "runAfter": {}
                  },
                  "EachReturnedClaim": {
                    "type": "Foreach",
                    "foreach": "@body('ReturnedClaims')?['value']",
                    "actions": {
                      "SameItem": {
                        "type": "If",
                        "expression": "@equals(items('EachReturnedClaim')?['ItemId'],string(body('Item')?['Id']))",
                        "actions": {
                          "ReopenClaim_Body": {
                            "type": "Compose",
                            "inputs": {
                              "ClaimStatus": "PENDING",
                              "ReturnedAt": null
                            },
                            "runAfter": {}
                          },
                          "ReopenClaim": {
                            "type": "OpenApiConnection",
                            "inputs": {
                              "host": {
                                "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                "connectionName": "shared_sharepointonline",
                                "operationId": "HttpRequest"
                              },
                              "parameters": {
                                "dataset": "https://cloudkobeu.sharepoint.com/teams/t-dxsuisin-tesvd2",
                                "parameters/method": "POST",
                                "parameters/uri": "_api/web/lists/getbytitle('LFClaims')/items(@{items('EachReturnedClaim')?['ID']})",
                                "parameters/headers": {
                                  "Accept": "application/json;odata=minimalmetadata",
                                  "Content-Type": "application/json;odata=nometadata",
                                  "X-HTTP-Method": "MERGE",
                                  "IF-MATCH": "*"
                                },
                                "parameters/body": "@string(outputs('ReopenClaim_Body'))"
                              },
                              "authentication": "@parameters('$authentication')"
                            },
                            "runAfter": {
                              "ReopenClaim_Body": [
                                "Succeeded"
                              ]
                            }
                          }
                        },
                        "else": {
                          "actions": {}
                        },
                        "runAfter": {}
                      }
                    },
                    "runtimeConfiguration": {
                      "concurrency": {
                        "repetitions": 1
                      }
                    },
                    "runAfter": {
                      "ReturnedClaims": [
                        "Succeeded"
                      ]
                    }
                  },
                  "AuditAvailable": {
                    "type": "If",
                    "expression": "@not(empty(json(body('Item')?['ReturnAudit'])))",
                    "actions": {
                      "LastCorrection": {
                        "type": "Compose",
                        "inputs": "@last(json(body('Item')?['ReturnAudit']))",
                        "runAfter": {}
                      },
                      "HadRequest": {
                        "type": "If",
                        "expression": "@not(empty(outputs('LastCorrection')?['requestId']))",
                        "actions": {
                          "PreviousRequest": {
                            "type": "OpenApiConnection",
                            "inputs": {
                              "host": {
                                "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                "connectionName": "shared_sharepointonline",
                                "operationId": "HttpRequest"
                              },
                              "parameters": {
                                "dataset": "https://cloudkobeu.sharepoint.com/teams/t-dxsuisin-tesvd2",
                                "parameters/method": "GET",
                                "parameters/uri": "_api/web/lists/getbytitle('LFRequests')/items(@{int(outputs('LastCorrection')?['requestId'])})?$select=*,Author/EMail&$expand=Author",
                                "parameters/headers": {
                                  "Accept": "application/json;odata=minimalmetadata",
                                  "Content-Type": "application/json;odata=nometadata"
                                }
                              },
                              "authentication": "@parameters('$authentication')"
                            },
                            "runAfter": {}
                          },
                          "OtherReturns": {
                            "type": "OpenApiConnection",
                            "inputs": {
                              "host": {
                                "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                "connectionName": "shared_sharepointonline",
                                "operationId": "HttpRequest"
                              },
                              "parameters": {
                                "dataset": "https://cloudkobeu.sharepoint.com/teams/t-dxsuisin-tesvd2",
                                "parameters/method": "GET",
                                "parameters/uri": "_api/web/lists/getbytitle('FoundItems')/items?$filter=RequestId eq '@{outputs('LastCorrection')?['requestId']}' and Status eq '返却済み'&$top=1",
                                "parameters/headers": {
                                  "Accept": "application/json;odata=minimalmetadata",
                                  "Content-Type": "application/json;odata=nometadata"
                                }
                              },
                              "authentication": "@parameters('$authentication')"
                            },
                            "runAfter": {
                              "PreviousRequest": [
                                "Succeeded"
                              ]
                            }
                          },
                          "CanReopen": {
                            "type": "If",
                            "expression": "@and(equals(body('PreviousRequest')?['RequestStatus'],'RESOLVED'),empty(body('OtherReturns')?['value']),equals(toLower(body('PreviousRequest')?['Author']?['EMail']),toLower(outputs('LastCorrection')?['recipient'])))",
                            "actions": {
                              "ReopenRequest_Body": {
                                "type": "Compose",
                                "inputs": {
                                  "RequestStatus": "ACTIVE"
                                },
                                "runAfter": {}
                              },
                              "ReopenRequest": {
                                "type": "OpenApiConnection",
                                "inputs": {
                                  "host": {
                                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                    "connectionName": "shared_sharepointonline",
                                    "operationId": "HttpRequest"
                                  },
                                  "parameters": {
                                    "dataset": "https://cloudkobeu.sharepoint.com/teams/t-dxsuisin-tesvd2",
                                    "parameters/method": "POST",
                                    "parameters/uri": "_api/web/lists/getbytitle('LFRequests')/items(@{body('PreviousRequest')?['Id']})",
                                    "parameters/headers": {
                                      "Accept": "application/json;odata=minimalmetadata",
                                      "Content-Type": "application/json;odata=nometadata",
                                      "X-HTTP-Method": "MERGE",
                                      "IF-MATCH": "@body('PreviousRequest')?['odata.etag']"
                                    },
                                    "parameters/body": "@string(outputs('ReopenRequest_Body'))"
                                  },
                                  "authentication": "@parameters('$authentication')"
                                },
                                "runAfter": {
                                  "ReopenRequest_Body": [
                                    "Succeeded"
                                  ]
                                }
                              }
