{
  "LFDailyPhotoBatches": {
    "access": "public",
    "attachments": true,
    "uniqueTitle": true,
    "viewFields": [
      "Title",
      "StorageWindow",
      "ReceivedOn",
      "Slot",
      "Attachments",
      "Modified"
    ],
    "fields": [
      {
        "name": "StorageWindow",
        "type": "Text",
        "indexed": true
      },
      {
        "name": "ReceivedOn",
        "type": "DateOnly",
        "indexed": true
      },
      {
        "name": "Slot",
        "type": "Number",
        "indexed": true
      },
      {
        "name": "SaveToken",
        "type": "Text"
      },
      {
        "name": "PhotoCount",
        "type": "Number",
        "indexed": true
      }
    ],
    "validationFormula": "=AND([Slot]>=1,[Slot]<=3,MOD([Slot],1)=0,[タイトル]=[StorageWindow]&\"|\"&TEXT([ReceivedOn],\"yyyy-mm-dd\")&\"|\"&TEXT([Slot],\"0\"))",
    "validationMessage": "写真の保存枠は窓口・受付日ごとに1〜3です。最新の写真画面から登録してください。"
  },
